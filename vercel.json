{
  "functions": {
    "api/nfse.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "has": [{ "type": "host", "value": "api.convoflow.com.br" }],
      "destination": "https://pqjkuwyshybxldzpfbbs.supabase.co/functions/v1/api-mcp"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "api.convoflow.com.br" }],
      "destination": "https://pqjkuwyshybxldzpfbbs.supabase.co/functions/v1/api-v1/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "${CORS_ORIGIN:-https://convoflow.vercel.app}"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Client-Info, apikey"
        },
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        }
      ]
    }
  ]
}
